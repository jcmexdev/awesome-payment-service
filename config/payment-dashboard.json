      "id": 1,
      "title": "Métricas del Sistema y Tasas de Logs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Muestra la cantidad de líneas de logs procesadas por minuto para cada servicio. Ayuda a identificar anomalías de volumen o loops de logs en contenedores específicos.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code",
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$service_name\"}[1m]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Tasa de Logs por Minuto (Log Rate)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Contador consolidado de logs que contienen la palabra 'ERROR' en la última hora. En un entorno sano, este valor debería mantenerse idealmente en 0.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=~\"$service_name\"} |= \"ERROR\"[1h]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs de Error en la Última Hora",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Total de pagos procesados con éxito (transacciones aprobadas y persistidas) en la última hora detectadas en los logs estructurados del servicio backend Go.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({service_name=\"payment_service\"} |= \"ProcessPayment\"[1h]))",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Transacciones de Pago Procesadas (1h)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 10,
      "title": "Métricas HTTP RED (Payment API)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Tasa de peticiones por segundo (RPS) procesadas por el servidor HTTP, agrupadas por método, ruta y código de respuesta. Mide el rendimiento global (Throughput).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "id": 11,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{service_name=~\"$service_name\"}[1m])) by (path, method, status)",
          "legendFormat": "{{method}} {{path}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "Tasa de Peticiones (HTTP RPS)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Porcentaje de peticiones fallidas (códigos HTTP 4xx y 5xx) frente al total de solicitudes. Permite monitorear la tasa de errores de la API en tiempo real.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "id": 12,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_requests_total{status=~\"[45]..\", service_name=~\"$service_name\"}[1m])) or vector(0)) / (sum(rate(http_requests_total{service_name=~\"$service_name\"}[1m])) or vector(1)) * 100",
          "legendFormat": "Tasa de Errores",
          "refId": "A"
        }
      ],
      "title": "Tasa de Errores HTTP (%)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Percentiles p50 (promedio), p95 (95% de las llamadas son más rápidas que esto) y p99 (latencia de cola del 1% más lento) en segundos para peticiones HTTP.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "id": 13,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service_name=~\"$service_name\"}[1m])) by (le))",
          "legendFormat": "p50 Latency",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service_name=~\"$service_name\"}[1m])) by (le))",
          "legendFormat": "p95 Latency",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service_name=~\"$service_name\"}[1m])) by (le))",
          "legendFormat": "p99 Latency",
          "refId": "C"
        }
      ],
      "title": "Latencia HTTP (p50, p95, p99)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 7,
      "title": "Métricas de Base de Datos (GORM & Postgres)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Monitorea la salud del pool de sockets hacia la base de datos PostgreSQL. Muestra las conexiones activas en uso (in_use), conexiones ociosas de reserva (idle) y el límite máximo configurado (max). Si las activas tocan el límite máximo frecuentemente, las peticiones HTTP se encolarán.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "id": 8,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "go_sql_in_use_connections{db_name=\"payment_db\", service_name=~\"$service_name\"}",
          "legendFormat": "Conexiones Activas",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "go_sql_idle_connections{db_name=\"payment_db\", service_name=~\"$service_name\"}",
          "legendFormat": "Conexiones Inactivas (Idle)",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "go_sql_max_open_connections{db_name=\"payment_db\", service_name=~\"$service_name\"}",
          "legendFormat": "Límite Máx Conexiones",
          "refId": "C"
        }
      ],
      "title": "Estadísticas del Pool de Conexiones GORM",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Mide la tasa de peticiones encoladas en el backend esperando a obtener una conexión del pool (Wait Count) y el tiempo acumulado de espera (Wait Duration). Picos en estas métricas indican que el pool está saturado y degradando las consultas.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "id": 14,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(go_sql_wait_duration_seconds_total{db_name=\"payment_db\", service_name=~\"$service_name\"}[1m])",
          "legendFormat": "Wait Duration (sec/s)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(go_sql_wait_count_total{db_name=\"payment_db\", service_name=~\"$service_name\"}[1m])",
          "legendFormat": "Wait Count (requests/s)",
          "refId": "B"
        }
      ],
      "title": "Tiempos de Espera & Cola de Conexión GORM",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Percentil 95 (p95) de la latencia (en milisegundos) de ejecución de queries SQL, derivado directamente de las trazas de GORM interceptadas por OTel. Durante pruebas de estrés con bloqueo pesimista (SELECT FOR UPDATE), verás picos altos en consultas bloqueadas.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "id": 15,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(traces_span_metrics_duration_milliseconds_bucket{span_name=~\"select.*|update.*|insert.*|delete.*\", exported_service_name=~\"$service_name\"}[1m])) by (le, span_name))",
          "legendFormat": "p95 - {{span_name}}",
          "refId": "A"
        }
      ],
      "title": "Latencia de Consultas SQL (OTel / GORM Spans)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Métricas del motor de PostgreSQL desglosando los Commits (transacciones exitosas) y Rollbacks (transacciones abortadas) por segundo. Picos de Rollbacks alertan fallos lógicos o conflictos concurrentes de llaves duplicadas.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "id": 9,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(pg_stat_database_xact_commit{datname=\"postgres\", service_name=~\"$service_name\"}[1m])",
          "legendFormat": "Commits / seg",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"postgres\", service_name=~\"$service_name\"}[1m])",
          "legendFormat": "Rollbacks / seg",
          "refId": "B"
        }
      ],
      "title": "Rendimiento de Transacciones Postgres",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Conexiones concurrentes establecidas en el motor de base de datos Postgres (backends). Mapea el número de sockets de clientes abiertos concurrentemente contra la base de datos.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "id": 16,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "pg_stat_database_numbackends{datname=\"postgres\", service_name=~\"$service_name\"}",
          "legendFormat": "Conexiones Activas",
          "refId": "A"
        }
      ],
      "title": "Conexiones de Servidor Postgres (postgres-exporter)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 20,
      "title": "Métricas de Redis (Idempotencia & System)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Comandos de Redis ejecutados por segundo desde el backend Go (desglosados por comando como GET, SET). Mide la tasa de lectura/escritura en la capa de idempotencia.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 36
      },
      "id": 21,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(redis_commands_total{service_name=~\"$service_name\"}[1m])) by (command)",
          "legendFormat": "Command: {{command}}",
          "refId": "A"
        }
      ],
      "title": "Redis Commands RPS",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Porcentaje de aciertos (Hits) y fallos (Misses) en Redis. Un 'Hit' indica que una petición de pago duplicada fue bloqueada exitosamente por coincidir su Idempotency-Key. Un 'Miss' indica que es una petición nueva.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "id": 22,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(redis_commands_total{status=\"hit\", service_name=~\"$service_name\"}[1m])) or vector(0)) / (sum(rate(redis_commands_total{status=~\"hit|miss\", service_name=~\"$service_name\"}[1m])) or vector(1)) * 100",
          "legendFormat": "Hit Ratio",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(rate(redis_commands_total{status=\"miss\", service_name=~\"$service_name\"}[1m])) or vector(0)) / (sum(rate(redis_commands_total{status=~\"hit|miss\", service_name=~\"$service_name\"}[1m])) or vector(1)) * 100",
          "legendFormat": "Miss Ratio",
          "refId": "B"
        }
      ],
      "title": "Redis Idempotency Hit/Miss Ratio",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "description": "Percentil 95 (p95) de duración de las operaciones contra Redis (en segundos), medido a través del hook Prometheus personalizado implementado en el backend Go.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 36
      },
      "id": 23,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum(rate(redis_command_duration_seconds_bucket{service_name=~\"$service_name\"}[1m])) by (le, command))",
          "legendFormat": "p95 {{command}}",
          "refId": "A"
        }
      ],
      "title": "Redis Command Latency (p95)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "id": 5,
      "title": "Visor de Logs de la Aplicación",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "Visualizador interactivo de logs de contenedores. Muestra mensajes estructurados JSON, resalta niveles (INFO/WARN/ERROR) y ofrece enlaces de rastreo distribuidos 'Tempo' si se detecta un trace_id.",
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false,
        "fontSize": "xs"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "Loki"
